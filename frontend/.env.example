# BECCI Public Website — Environment Configuration Template (CRA / CRACO)
# Copy to .env.development.local (dev) or set in your CI/hosting environment (staging/production).
# NEVER hardcode localhost URLs in staging or production builds.

# Base URL of the separate BECCI Opportunity Intelligence Engine FastAPI service (no trailing slash).
# Development example: http://127.0.0.1:8000
# Staging example:     https://staging-api.becci.in
# Production example:  https://api.becci.in
REACT_APP_BECCI_API_BASE_URL=

# Optional: Deployment environment label (development | staging | production)
REACT_APP_ENV=development

# Optional: External URL to the backend's built-in admin interface (defaults to ${REACT_APP_BECCI_API_BASE_URL}/admin)
REACT_APP_BECCI_ADMIN_URL=
